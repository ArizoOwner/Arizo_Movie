{
  "name": "arizo-movie",
  "version": "2.1.1",
  "description": "24/7 Serverless Telegram Movie Bot running on Cloudflare Workers with D1 and Web Setup Wizard",
  "main": "worker.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create arizo-movie-db",
    "d1:init": "wrangler d1 execute arizo-movie-db --file=./schema.sql"
  },
  "keywords": [
    "telegram-bot",
    "cloudflare-workers",
    "serverless",
    "moviebot",
    "tmdb",
    "d1",
    "telegram"
  ],
  "author": "ArizoOwner",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
